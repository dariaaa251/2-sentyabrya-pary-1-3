class CPU:
    def __init__(self, name, fr):
        self.name = name
        self.fr = fr
class Memory:
    def __init__(self, name, volume):
        self.name = name
        self.volume = volume
class MotherBoard:
    total_mem_slots = 4
    
    def __init__(self, name, cpu, *mem_slots):
        self.name = name
        self.cpu = cpu
        self.mem_slots = list(mem_slots[:self.total_mem_slots])
    
    def get_config(self):
        if self.mem_slots:
            memory_str = '; '.join([f"{mem.name} - {mem.volume}" for mem in self.mem_slots])
        else:
            memory_str = ""
        
        return [
            f'Материнская плата: {self.name}',
            f'Центральный процессор: {self.cpu.name}, {self.cpu.fr}',
            f'Слотов памяти: {self.total_mem_slots}',
            f'Память: {memory_str}'
        ]

cpu = CPU('Intel Core i5', 3200)
mem1 = Memory('Corsair', 8192)
mem2 = Memory('ASUS', 8192)

mb = MotherBoard('ASUS ROG', cpu, mem1, mem2)

print(mb.get_config())