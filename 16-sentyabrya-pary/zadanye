class Data:
    def __init__(self, data, ip):
        self.data = data
        self.ip = ip

class Server:
    _ip_counter = 0

    def __init__(self):
        Server._ip_counter += 1
        self.ip = Server._ip_counter
        self.buffer = []

    def send_data(self, data):
        router.buffer.append(data)

    def get_data(self):
        received = self.buffer[:]
        self.buffer.clear()
        return received

    def get_ip(self):
        return self.ip


class Router:
    def __init__(self):
        self.buffer = []
        self.servers = {}

    def link(self, server):
        self.servers[server.get_ip()] = server

    def unlink(self, server):
        self.servers.pop(server.get_ip(), None)

    def send_data(self):
        for data in self.buffer:
            if data.ip in self.servers:
                self.servers[data.ip].buffer.append(data)
        self.buffer.clear()