class Figure:
    def __init__(self, coords, width, color):
        self.coords = coords
        self.width = width
        self.color = color

    def draw(self):
        print("Рисуется фигура")

class Line(Figure):
    def draw(self):
        print("Рисуется линия")

class Rect(Figure):
    def draw(self):
        print("Рисуется прямоугольник")

class Ellipse(Figure):
    def draw(self):
        print("Рисуется эллипс")

figures = [
    Line((0, 0, 10, 10), 2, 'red'),
    Rect((5, 5, 20, 30), 3, 'blue'),
    Ellipse((1, 1, 15, 8), 1, 'green')
]

for fig in figures:
    fig.draw()