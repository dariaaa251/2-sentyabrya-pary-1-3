class CPU:
    def __init__(self, name, fr):
        self.name = name
        self.fr = fr
class Memory:
    def __init__(self, name, volume):
        self.name = name
        self.volume = volume
class MotherBoard:
    def __init__(self, name, cpu, *mem_slots):
        self.name = name
        self.cpu = cpu
        self.mem_slots = list(mem_slots)  

    def get_config(self):
        config = [f"Материнская плата: {self.name}"]

        config.append(f"Процессор: {self.cpu.name}, {self.cpu.fr}")

        mem_names = [mem.name for mem in self.mem_slots]
        config.append(f"Слоты памяти: {', '.join(mem_names)}")

        mem_info = [f"{mem.name} - {mem.volume}" for mem in self.mem_slots]
        config.append(f"Память: {'; '.join(mem_info)}")

        return config

cpu = CPU('Intel Core i7', 3600)
mem1 = Memory('Kingston', 8192)
mem2 = Memory('Kingston', 8192)

mb = MotherBoard('ASUS Prime', cpu, mem1, mem2)
print(mb.get_config())