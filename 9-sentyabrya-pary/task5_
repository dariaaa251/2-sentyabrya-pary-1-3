class Point:
    def __init__(self, x, y, color='black'):
        self.x = x
        self.y = y
        self.color = color


p1 = Point(10, 20)
p2 = Point(12, 5, 'red')


points = [
    Point(0, 0),              
    Point(1, 1, 'red'),       
    Point(2, 2, 'green')      
]

# Проверка
for p in points:
    print(f"x={p.x}, y={p.y}, color={p.color}")

print(p1.x, p1.y, p1.color)  
print(p2.x, p2.y, p2.color)   